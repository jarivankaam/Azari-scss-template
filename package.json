{
  "name": "azari-scss-template",
  "version": "1.0.0",
  "private": true,
  "description": "Custom SCSS setup with the Bootstrap 5 grid (Dart Sass, @use modules)",
  "scripts": {
    "build": "sass --load-path=node_modules --quiet-deps --silence-deprecation=import --style=compressed --no-source-map scss/main.scss:dist/css/main.css scss/checkout.scss:dist/css/checkout.css",
    "watch": "sass --load-path=node_modules --quiet-deps --silence-deprecation=import --watch --embed-sources scss/main.scss:dist/css/main.css scss/checkout.scss:dist/css/checkout.css",
    "dev": "npm run watch"
  },
  "devDependencies": {
    "bootstrap": "^5.3.9",
    "sass": "^1.108.2"
  }
}
